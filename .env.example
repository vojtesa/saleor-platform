# =============================================================================
# A-green eshop — local development .env
# Copy to .env and fill in real values.
# =============================================================================

# === Saleor ===
SECRET_KEY=changeme
# Session length — 30 min access + 30 min refresh = hard 30-minute login session
JWT_TTL_ACCESS=30 minutes
JWT_TTL_REFRESH=30 minutes

# === Workflow / Payments ===
WORKFLOW_API_KEY=workflow-dev-key-change-in-production
FIO_API_TOKEN=

# === Comgate ===
COMGATE_SECRET_KEY=changeme
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=1
SALEOR_API_URL=http://api:8000/graphql/
SYNC_WEBHOOK_URL=http://workflow-service:3001/api/webhooks

# === Email ===
NOTIFICATION_EMAIL=eshop@a-green.cz
WORKFLOW_SMTP_HOST=mailpit
WORKFLOW_SMTP_PORT=1025
SALEOR_DASHBOARD_URL=http://localhost:9000
# Bankovní účet pro QR platby v e-mailech (stejné hodnoty jako produkce)
PAYMENT_BANK_ACCOUNT=2303550009/2010
PAYMENT_BANK_IBAN=CZ3620100000002303550009
# Veřejná URL, odkud si mail klienti načítají QR obrázek — lokální HTTPS
# doména z Caddyfile (funguje na notebooku, kde je /etc/hosts + lokální CA)
EMAIL_PUBLIC_BASE_URL=https://workflow.local.a-green.cz
# HMAC secret e-mail webhooků — build vyžaduje v NODE_ENV=production.
# Stejnou hodnotu musí mít webhooky v Saleoru (sync-webhooks.py).
EMAIL_WEBHOOK_SECRET=dev-email-webhook-secret-local
