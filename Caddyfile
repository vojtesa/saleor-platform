# Lokální HTTPS reverse proxy pro dev stack (mkcert certifikáty).
# Domény local.a-green.cz existují JEN v /etc/hosts (127.0.0.1) — nejsou
# v žádném veřejném DNS. Bind na 127.0.0.1 = z LANu se na dev stack nedostane.
# Certifikáty: scripts/setup-local-https.sh
{
	admin off
}

www.local.a-green.cz {
	bind 127.0.0.1
	tls certs/_wildcard.local.a-green.cz.pem certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy 127.0.0.1:3000 # frontend (pnpm dev)
}

api.local.a-green.cz {
	bind 127.0.0.1
	tls certs/_wildcard.local.a-green.cz.pem certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy 127.0.0.1:8000 # Saleor API (docker compose)
}

workflow.local.a-green.cz {
	bind 127.0.0.1
	tls certs/_wildcard.local.a-green.cz.pem certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy 127.0.0.1:3002 # workflow-service (docker compose)
}

dashboard.local.a-green.cz {
	bind 127.0.0.1
	tls certs/_wildcard.local.a-green.cz.pem certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy 127.0.0.1:9000 # Saleor dashboard (docker compose)
}
