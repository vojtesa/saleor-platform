# Lokální HTTPS reverse proxy (běží jako docker compose služba `caddy`).
# Domény local.a-green.cz existují JEN v /etc/hosts (127.0.0.1) — nejsou
# v žádném veřejném DNS. Porty 443/80 jsou v compose publikované jen na
# 127.0.0.1 = z LANu se na dev stack nedostane.
# Certifikáty: scripts/setup-local-https.sh (mkcert, mount ./certs)
{
	admin off
}

www.local.a-green.cz {
	tls /certs/_wildcard.local.a-green.cz.pem /certs/_wildcard.local.a-green.cz-key.pem

	# Média — stejný vzor jako produkce (Traefik: a-green.cz/media/* →
	# stripPrefix /media → minio). Saleor staví URL médií jako
	# https://www.local.a-green.cz/media/saleor-media/… (backend.env:
	# AWS_MEDIA_CUSTOM_DOMAIN) — zde odebereme prefix /media a jdeme
	# path-style do MinIO: /saleor-media/<objekt> = bucket `saleor-media`.
	handle /media/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}

	reverse_proxy host.docker.internal:3000 # frontend (pnpm dev na hostu)
}

api.local.a-green.cz {
	tls /certs/_wildcard.local.a-green.cz.pem /certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy api:8000 # Saleor API (docker compose)
}

workflow.local.a-green.cz {
	tls /certs/_wildcard.local.a-green.cz.pem /certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy workflow-service:3001 # workflow-service (docker compose)
}

dashboard.local.a-green.cz {
	tls /certs/_wildcard.local.a-green.cz.pem /certs/_wildcard.local.a-green.cz-key.pem
	reverse_proxy dashboard:80 # Saleor dashboard (docker compose)
}
